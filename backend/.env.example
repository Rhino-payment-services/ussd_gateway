NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ussd:ussd_secret@localhost:5432/ussd_gateway?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_SECONDS=180
WEBHOOK_TIMEOUT_MS=8000
ALLOW_ANONYMOUS_SIMULATE=true
SIMULATE_RATE_LIMIT_WINDOW_MS=60000
SIMULATE_RATE_LIMIT_MAX=300
